###############################################################################
# Application
###############################################################################
APP_NAME="مركز تدريب القيادة"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Arabic is the shipped interface language; English falls back through the
# same lang/ files.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_JO

APP_TIMEZONE=Asia/Amman
APP_MAINTENANCE_DRIVER=file

###############################################################################
# Database — MySQL only
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=driving_center
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Session, cache, queue
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database

# `database` is fine for a single center. Switch to `redis` when running
# multiple queue workers.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Sanctum — mobile API authentication
###############################################################################
# Domains allowed to authenticate with the session cookie. Mobile clients use
# bearer tokens and do not need to be listed here.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

###############################################################################
# File storage
###############################################################################
# The public disk holds avatars; the private disk holds identity documents,
# receipts and invoices and is never served directly by the web server.
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private

# Switch PRIVATE_FILESYSTEM_DISK to s3 in production and fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Receives the nightly finance:verify report when it fails.
MAIL_ADMIN_ADDRESS=

###############################################################################
# External notification providers (optional)
###############################################################################
# In-app notifications work out of the box. SMS, WhatsApp and push sit behind
# ChannelGateway implementations and stay disabled — logging instead of
# sending — until a provider is configured here and enabled in Settings.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Push uses FCM's HTTP v1 API, which signs requests with a service account
# rather than the retired server key. Point this at the JSON file — never paste
# the key itself into an environment variable, where it would reach logs and
# crash reports. Keep the file outside the web root, chmod 600.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Login passcodes (trainee sign-in)
# ---------------------------------------------------------------------------
# OTP_FIXED_CODES enables the per-role demo passcodes in config/otp.php, and
# OTP_EXPOSE_CODE returns the generated code in the API response so the apps can
# be driven without a provider. BOTH default to off when APP_ENV=production and
# must stay off there.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER=60
OTP_HOURLY_LIMIT=5
# OTP_FIXED_CODES=true
# OTP_EXPOSE_CODE=true

# ---------------------------------------------------------------------------
# Outbound messaging (notifications + login passcodes)
# ---------------------------------------------------------------------------
# A channel needs two yeses: switched on under الإعدادات ← الإشعارات, and
# configured here. Leave these blank and messages are written to the log.
MESSAGING_COUNTRY_CODE=962

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Leave the template blank to send plain text (valid only inside Meta's 24h window).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar

###############################################################################
# Demo passcodes (optional)
###############################################################################
# Lets a demo account sign in without a live SMS provider. Two variables: one
# switch, one map.
#
#   OTP_ENABLE_FIXED_CODES=true
#   OTP_FIXED_CODES="0790000007:777777,0790000006:666666"
#
# A fixed passcode is a standing credential, so the service refuses one for any
# account holding a sensitive permission — it can open a demo trainee or trainer
# and never an administrator. Leave both unset unless a demo needs them.
OTP_ENABLE_FIXED_CODES=
OTP_FIXED_CODES=
